# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Neon connection string (the pooled one), no quotes
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require

# Password shared by all seeded demo accounts (pick your own)
DEMO_PASSWORD=choose-a-demo-password

# Signs the login cookie. Use a long random string (32+ characters).
SESSION_SECRET=replace-with-a-long-random-string

# Vercel Cron sends this to /api/cron/reset for the nightly demo reset
CRON_SECRET=replace-with-another-long-random-string
